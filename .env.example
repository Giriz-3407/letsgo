# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Optional for local sample testing, required for Drive)
# Create credentials in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Storage Provider: "local" (default) or "google_drive"
STORAGE_PROVIDER=local

# Security & Sessions
SESSION_SECRET=watchtogether-secret-change-in-production-random-key-999

# Future Extensibility (S3 / Cloudflare R2 / Redis)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# REDIS_URL=redis://localhost:6379/0
