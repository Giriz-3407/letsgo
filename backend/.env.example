# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Required for Google Drive integration)
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Storage Provider: "local" (default) or "google_drive"
STORAGE_PROVIDER=local

# Security & Session Secret
SESSION_SECRET=watchtogether-secret-key-change-in-production-12345

# Future Redis / Object Storage Extensibility
# REDIS_URL=redis://localhost:6379/0
